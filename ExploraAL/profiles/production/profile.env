# Production versions: ROOT 6.24/06, Geant4 10.07.p01, geant3 v3-8, VMC v1-0-p3, GenFit 02-00-01
# (allsources 2d35bde, 2022-07-28). Sourced by fetch-sources.sh, make.sh and the Dockerfile;
# values given in the environment win.
: "${ALLSOURCES_REF:=2d35bde62d90957be9ae79abc4b8c5281c96feed}"
: "${GENFIT_REF:=02-00-01}"
# gfortran >= 10 rejects the argument mismatches in the old geant3 / Pythia6 Fortran
export FFLAGS="-fallow-argument-mismatch"
