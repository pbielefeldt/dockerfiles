# Copy to .env and fill in. .env is ignored by git and docker; never commit it.
# Use GitLab personal access tokens with (at least) scope read_repository.

# for agthoma.hiskp.uni-bonn.de/gitlab (explora, allsources, CBTTpcDrift, CBTVertexCorrection)
AG_THOMA_GITLAB_USERNAME=
AG_THOMA_GITLAB_TOKEN=

# for gitlab.uni-bonn.de (ExportTrackPoints, CBTMCPrimeClusterer, CBTTpcEventDisplay)
UNI_BONN_GITLAB_USERNAME=
UNI_BONN_GITLAB_TOKEN=
